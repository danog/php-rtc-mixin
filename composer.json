{
    "name": "danog/php-rtc-mixin",
    "type": "library",
    "description": "This library builds upon common PHP classes and traits shared across the WebRTC ecosystem. Fork with FFI made optional and a pure-PHP DTLS/SRTP stack, maintained for MadelineProto.",
    "keywords": [
        "webrtc"
    ],
    "homepage": "https://www.quasarstream.com/webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community",
            "homepage": "https://quasarstream.com/teams"
        }
    ],
    "require": {
        "php": "^8.2",
        "evenement/evenement": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\Mixin\\": "src"
        }
    },
    "minimum-stability": "dev",
    "replace": {
        "quasarstream/mixin": "self.version"
    }
}
